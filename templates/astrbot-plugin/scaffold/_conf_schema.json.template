{
  "timeout": {
    "type": "int",
    "description": "超时时间（秒）",
    "hint": "超过该时长未响应即判定失败并重试",
    "default": 30,
    "slider": {"min": 1, "max": 300, "step": 1}
  },
  "max_retries": {
    "type": "int",
    "description": "最大重试次数",
    "hint": "失败后最多再试几次，填 0 表示不重试",
    "default": 3,
    "slider": {"min": 0, "max": 10, "step": 1}
  },
  "max_concurrency": {
    "type": "int",
    "description": "并发上限",
    "hint": "同时处理的任务数量上限，超出后排队",
    "default": 3,
    "slider": {"min": 1, "max": 20, "step": 1}
  },
  "notify_admin": {
    "type": "bool",
    "description": "失败时通知管理员",
    "default": true
  }
}
